function DarkModeToggle() {
  const [dark, setDark] = useState(false);
  const [mounted, setMounted] = useState(false);

  useEffect(() => {
    setMounted(true);
    const isDark =
      localStorage.getItem("theme") === "dark" ||
      (!localStorage.getItem("theme") &&
        window.matchMedia("(prefers-color-scheme: dark)").matches);
    setDark(isDark);
    document.documentElement.classList.toggle("dark", isDark);
  }, []);

  const toggle = () => {
    const newDark = !dark;
    setDark(newDark);
    localStorage.setItem("theme", newDark ? "dark" : "light");
    document.documentElement.classList.toggle("dark", newDark);
  };

  if (!mounted) {
    return <button className="theme-toggle" aria-label="Toggle theme"><MoonIcon /></button>;
  }

  return (
    <button onClick={toggle} className="theme-toggle" aria-label="Toggle theme">
      {dark ? <SunIcon /> : <MoonIcon />}
    </button>
  );
}

// ========================================
// INTERSECTION OBSERVER HOOK
// ========================================

function useIntersectionObserver(options?: IntersectionObserverInit) {
  const [isVisible, setIsVisible] = useState(false);
  const ref = useRef<HTMLDivElement>(null);

  useEffect(() => {
    const element = ref.current;
    if (!element) return;

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          setIsVisible(true);
          observer.unobserve(element); // Only animate once
        }
      },
      { threshold: 0.1, ...options }
    );

    observer.observe(element);
    return () => observer.disconnect();
  }, [options]);

  return { ref, isVisible };
}

// Animated container component
function AnimatedSection({ 
  children, 
  delay = 0,
  className = "" 
}: { 
  children: React.ReactNode; 
  delay?: number;
  className?: string;
}) {
  const { ref, isVisible } = useIntersectionObserver();

  return (
    <div
      ref={ref}
      className={`animate-on-scroll ${isVisible ? "is-visible" : ""} ${className}`}
      style={{ transitionDelay: `${delay}ms` }}
    >
      {children}
    </div>
  );
}

// ========================================
// PREMIUM SCROLL SNAP HOOK
// ========================================

/**
 * Premium scroll snap implementation
 * 
 * Philosophy: Let CSS handle the heavy lifting, JS only enhances edge cases
 * 
 * Key insight from research:
 * - CSS scroll-snap feels native because the browser handles momentum/easing
 * - JS-based snap feels like "scrolljacking" and fights the browser
 * - The only place CSS fails is mouse wheel: discrete delta events cause jumpy behavior
 * 
 * Solution:
 * - CSS: scroll-snap-type: y mandatory + scroll-snap-stop: always
 * - JS: Only intercept mouse wheel to debounce rapid discrete events
 * - Touch/trackpad: Let CSS + browser momentum handle it (feels premium)
 */
function usePremiumScrollSnap(containerRef: React.RefObject<HTMLElement | null>) {
  const isScrollingRef = useRef(false);
  const wheelTimeoutRef = useRef<NodeJS.Timeout | null>(null);
  const lastWheelTimeRef = useRef(0);
  const accumulatedDeltaRef = useRef(0);
  
  useEffect(() => {
    const container = containerRef.current;
    if (!container) return;

    // Detect if user is using a trackpad vs mouse wheel
    // Trackpad: many small deltas in quick succession
    // Mouse wheel: fewer, larger deltas with gaps
    let wheelEventCount = 0;
    let wheelEventResetTimeout: NodeJS.Timeout | null = null;
    
    const handleWheel = (e: WheelEvent) => {
      // Don't interfere with horizontal scrolling or pinch zoom
      if (Math.abs(e.deltaX) > Math.abs(e.deltaY) || e.ctrlKey) return;
      
      const now = performance.now();
      const timeSinceLastWheel = now - lastWheelTimeRef.current;
      lastWheelTimeRef.current = now;
      
      // Track wheel event frequency to detect trackpad
      wheelEventCount++;
      if (wheelEventResetTimeout) clearTimeout(wheelEventResetTimeout);
      wheelEventResetTimeout = setTimeout(() => { wheelEventCount = 0; }, 100);
      
      // Trackpad detection: many events (>3) in quick succession (<50ms gaps) with small deltas
      const isLikelyTrackpad = wheelEventCount > 3 && timeSinceLastWheel < 50 && Math.abs(e.deltaY) < 50;
      
      // Let trackpad/touch events flow naturally - CSS snap handles them beautifully
      if (isLikelyTrackpad) {
        return; // Don't prevent default, let CSS snap work
      }
      
      // For mouse wheel: debounce and snap one section at a time
      // This prevents the "machine gun" effect of rapid wheel clicks
      
      // If we're already animating, ignore additional wheel events
      if (isScrollingRef.current) {
        e.preventDefault();
        return;
      }
      
      // Accumulate delta for mouse wheel (handles different wheel speeds)
      accumulatedDeltaRef.current += e.deltaY;
      
      // Clear any pending snap
      if (wheelTimeoutRef.current) {
        clearTimeout(wheelTimeoutRef.current);
      }
      
      // Wait for wheel events to settle, then snap
      wheelTimeoutRef.current = setTimeout(() => {
        const delta = accumulatedDeltaRef.current;
        accumulatedDeltaRef.current = 0;
        
        if (Math.abs(delta) < 10) return; // Ignore tiny movements
        
        const sectionHeight = window.innerHeight;
        const currentScroll = container.scrollTop;
        const currentSection = Math.round(currentScroll / sectionHeight);
        const maxSection = Math.round((container.scrollHeight - sectionHeight) / sectionHeight);
        
        // Determine direction and target section
        const direction = delta > 0 ? 1 : -1;
        const targetSection = Math.max(0, Math.min(maxSection, currentSection + direction));
        const targetScroll = targetSection * sectionHeight;
        
        // Only animate if we're moving to a different section
        if (targetScroll !== currentScroll) {
          isScrollingRef.current = true;
          
          // Use native smooth scroll - browser handles the easing perfectly
          container.scrollTo({
            top: targetScroll,
            behavior: 'smooth'
          });
          
          // Reset scrolling flag after animation completes
          // Browser smooth scroll is typically 300-500ms
          setTimeout(() => {
            isScrollingRef.current = false;
          }, 600);
        }
      }, 50); // 50ms debounce - fast enough to feel responsive
      
      // Prevent default to stop janky scroll during debounce
      e.preventDefault();
    };

    // Use passive: false to allow preventDefault
    container.addEventListener('wheel', handleWheel, { passive: false });

    return () => {
      container.removeEventListener('wheel', handleWheel);
      if (wheelTimeoutRef.current) clearTimeout(wheelTimeoutRef.current);
      if (wheelEventResetTimeout) clearTimeout(wheelEventResetTimeout);
    };
  }, [containerRef]);
}

