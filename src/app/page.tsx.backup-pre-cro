function Header({ activeSection, onNavigate }: { activeSection: string; onNavigate: (id: string) => void }) {
  const [scrolled, setScrolled] = useState(false);

  useEffect(() => {
    let ticking = false;
    
    const handleScroll = (e: Event) => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const target = e.target as HTMLElement;
          const scrollTop = target.scrollTop || 0;
          setScrolled(scrollTop > 300);
          ticking = false;
        });
        ticking = true;
      }
    };

    const snapContainer = document.querySelector('.snap-container');
    if (snapContainer) {
      snapContainer.addEventListener('scroll', handleScroll, { passive: true });
      return () => snapContainer.removeEventListener('scroll', handleScroll);
    }
  }, []);

  const handleNavClick = (e: React.MouseEvent, id: string) => {
    e.preventDefault();
    onNavigate(id);
  };

  return (
    <header className="fixed top-0 left-0 right-0 z-50 bg-background/95 backdrop-blur-md border-b border-border">
      <div className="container">
        <div className="relative flex items-center justify-between h-14">
          <Logo showText={scrolled} onNavigate={onNavigate} />
          
          {/* Nav links - natural flow on mobile, centered on desktop */}
          <nav className="flex items-center gap-4 sm:gap-8 sm:absolute sm:left-1/2 sm:-translate-x-1/2">
            <a 
              href="#newsletter" 
              onClick={(e) => handleNavClick(e, 'newsletter')}
              className={`nav-link text-body-sm transition-colors ${
                activeSection === 'newsletter' 
                  ? 'text-ultra-orange nav-link-active' 
                  : 'text-muted hover:text-foreground'
              }`}
            >
              Newsletter
            </a>
            <a 
              href="#about" 
              onClick={(e) => handleNavClick(e, 'about')}
              className={`nav-link text-body-sm transition-colors ${
                activeSection === 'about' 
                  ? 'text-ultra-orange nav-link-active' 
                  : 'text-muted hover:text-foreground'
              }`}
            >
              About
            </a>
          </nav>

          {/* Theme toggle - only visible on desktop (sm+) */}
          <div className="hidden sm:block">
            <DarkModeToggle />
          </div>
        </div>
      </div>
    </header>
  );
}

/**
 * DecorativeSymbols - JS Parallax with subtle depth effect
 * 
 * Approach: Simple transform offsets based on scroll position
 * - Subtle ratios (0.05-0.15) create depth without distraction
 * - No CSS 3D (simpler, more predictable with snap scroll)
 * - Disabled on mobile via CSS media query
 */
function DecorativeSymbols({ scrollY = 0 }: { scrollY?: number }) {
  // Subtle parallax ratios - premium sites use very small values
  const ringY = scrollY * 0.12;
  const gridY = scrollY * 0.08;
  const plusY = scrollY * 0.04;
  
  return (
    <div className="absolute inset-0 overflow-hidden pointer-events-none select-none parallax-container">
      {/* Ring - Slowest (furthest back) */}
      <RingIcon 
        className="absolute text-ultra-orange parallax-element"
        style={{ 
          width: 'clamp(160px, 21vw, 280px)',
          height: 'auto',
          top: '-5%',
          left: '50%',
          transform: `translate3d(0, ${ringY}px, 0)`,
        }}
      />

      {/* Grid - Medium depth */}
      <GridIcon 
        className="absolute text-ultra-orange hidden sm:block parallax-element"
        style={{ 
          width: 'clamp(200px, 40vw, 420px)',
          height: 'auto',
          top: '25%',
          right: '-5%',
          transform: `translate3d(0, ${gridY}px, 0)`,
        }}
      />

      {/* Plus - Closest to content */}
      <PlusIcon 
        className="absolute text-ultra-orange parallax-element"
        style={{ 
          width: 'clamp(140px, 22vw, 240px)',
          height: 'auto',
          bottom: '-8%',
          left: '48%',
          transform: `translate3d(-50%, ${-plusY}px, 0)`,
        }}
      />
    </div>
  );
}

