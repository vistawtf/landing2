@import "tailwindcss";

:root {
  /* Light Mode (Default) */
  --background: #FFFFFF;
  --foreground: #111111;
  --surface: #FAFAFA;
  --surface-hover: #F5F5F5;
  --border: #E4E2D8;
  --border-hover: #CCCCCC;
  --muted: #666666;
  --muted-light: #888888;

  /* Vista Brand Colors (persist across modes) */
  --ultra-orange: #FF5233;
  --medium-orange: #FF7043;
  --light-orange: #FF8A65;
  --ultra-blue: #2962FF;
  --medium-blue: #448AFF;
  --light-blue: #90CAF9;
  --ultra-purple: #BA68C8;
  --medium-purple: #EA80FC;
  --light-purple: #CE93D8;
  --medium-lime: #B2FF59;
  --light-lime: #C5E1A5;

  /* Legacy support */
  --vista-black: #111111;
  --vista-dark: #0a0a0a;
  --vista-light: #E4E2D8;
  --ultra-gray: #191919;
  --idle-gray: #1a1a1a;
  --surface-gray: #161616;
  --border-gray: #2a2a2a;
  --medium-gray: #575757;
  --light-gray: #888888;
  --muted-gray: #666666;

  /* Spacing - 8px grid */
  --space-1: 4px;
  --space-2: 8px;
  --space-3: 12px;
  --space-4: 16px;
  --space-5: 20px;
  --space-6: 24px;
  --space-8: 32px;
  --space-10: 40px;
  --space-12: 48px;
  --space-16: 64px;
  --space-20: 80px;
  --space-24: 96px;
}

/* Dark Mode */
.dark {
  --background: #111111;
  --foreground: #E4E2D8;
  --surface: #161616;
  --surface-hover: #1a1a1a;
  --border: #2a2a2a;
  --border-hover: #575757;
  --muted: #888888;
  --muted-light: #666666;
}

@theme inline {
  /* Semantic colors */
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --color-surface: var(--surface);
  --color-surface-hover: var(--surface-hover);
  --color-border: var(--border);
  --color-border-hover: var(--border-hover);
  --color-muted: var(--muted);
  --color-muted-light: var(--muted-light);

  /* Legacy Neutrals (for backward compat) */
  --color-vista-black: var(--vista-black);
  --color-vista-dark: var(--vista-dark);
  --color-vista-light: var(--vista-light);
  --color-ultra-gray: var(--ultra-gray);
  --color-idle-gray: var(--idle-gray);
  --color-surface-gray: var(--surface-gray);
  --color-border-gray: var(--border-gray);
  --color-medium-gray: var(--medium-gray);
  --color-light-gray: var(--light-gray);
  --color-muted-gray: var(--muted-gray);

  /* Primary - Orange */
  --color-ultra-orange: var(--ultra-orange);
  --color-medium-orange: var(--medium-orange);
  --color-light-orange: var(--light-orange);

  /* Secondary - Blue */
  --color-ultra-blue: var(--ultra-blue);
  --color-medium-blue: var(--medium-blue);
  --color-light-blue: var(--light-blue);

  /* Secondary - Purple */
  --color-ultra-purple: var(--ultra-purple);
  --color-medium-purple: var(--medium-purple);
  --color-light-purple: var(--light-purple);

  /* Secondary - Lime */
  --color-medium-lime: var(--medium-lime);
  --color-light-lime: var(--light-lime);

  /* Fonts */
  --font-sans: var(--font-geist-sans), system-ui, -apple-system, sans-serif;
  --font-mono: var(--font-geist-mono), 'SF Mono', Monaco, monospace;
}

/* ========================================
   BASE STYLES
   ======================================== */

html {
  font-size: 16px;
  height: 100%;
  overflow: hidden; /* Scrolling happens in snap-container, not html */
  /* Note: scroll-behavior: smooth is on .snap-container, not html */
}

body {
  background: var(--background);
  color: var(--foreground);
  font-family: var(--font-sans);
  font-feature-settings: 'kern' 1, 'liga' 1;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  line-height: 1.5;
  transition: background-color 0.2s ease, color 0.2s ease;
  height: 100%;
  overflow: hidden; /* Scrolling happens in snap-container */
}

/* ========================================
   SNAP SCROLL SYSTEM - PREMIUM
   ======================================== 
   
   Philosophy: Let CSS do the heavy lifting.
   Browser-native scroll-snap feels premium because:
   - Respects platform momentum (iOS/Android/macOS)
   - Uses system-native easing curves
   - No "scrolljacking" feel
   
   JS enhancement only for mouse wheel edge case.
*/

.snap-container {
  scroll-snap-type: y mandatory;
  scroll-behavior: smooth; /* Native smooth scroll for programmatic scrolls */
  overflow-y: scroll;
  overflow-x: hidden; /* Prevent horizontal scroll from scaled elements */
  height: 100vh;
  height: 100dvh;
  overscroll-behavior: none; /* Prevent scroll chaining/bounce */
  -webkit-overflow-scrolling: touch; /* iOS momentum scrolling */
  
  /* Performance: hint that this element will scroll */
  will-change: scroll-position;
  
  /* PARALLAX: Create 3D viewport on scroll container
     300px gives subtle, premium parallax effect
     This makes translateZ actually affect scroll speed */
  perspective: 300px;
  perspective-origin: center top;
}

/* Prevent overscroll glow/bounce on Android/iOS */
@supports (overscroll-behavior-y: none) {
  .snap-container {
    overscroll-behavior-y: none;
  }
}

.snap-section {
  scroll-snap-align: start;
  scroll-snap-stop: always; /* CRITICAL: Forces stop at each section, no skipping */
  height: 100vh;
  height: 100dvh;
  min-height: 100vh;
  max-height: 100vh;
  max-height: 100dvh;
  display: flex;
  flex-direction: column;
  overflow: hidden; /* Prevent content overflow breaking snap */
  position: relative;
  
  /* Preserve 3D context for parallax elements */
  transform-style: preserve-3d;
}

/* Section content centering */
.snap-section-center {
  display: flex;
  flex-direction: column;
  justify-content: center;
  flex: 1;
  overflow: hidden;
}

/* Last section - footer at bottom */
.snap-section-end {
  justify-content: space-between;
  overflow: hidden;
}

/* ========================================
   ABOUT SECTION - MOBILE OPTIMIZED
   ======================================== */

.about-content {
  display: flex;
  flex-direction: column;
  justify-content: center;
  flex: 1;
  padding: 4rem 0 1.5rem;
}

@media (min-width: 640px) {
  .about-content {
    padding: 5rem 0 1.75rem;
  }
}

@media (min-width: 1024px) {
  .about-content {
    padding: 7rem 0;
  }
}

/* ========================================
   FOOTER - COMPACT MOBILE
   ======================================== */

.footer-compact {
  padding: 1rem 0;
  border-top: 2px solid var(--foreground);
  flex-shrink: 0;
}

@media (min-width: 640px) {
  .footer-compact {
    padding: 3rem 0;
  }
}

/* ========================================
   NAV LINK ACTIVE INDICATOR
   ======================================== */

.nav-link {
  position: relative;
  padding-bottom: 4px;
}

.nav-link::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 2px;
  background: var(--ultra-orange);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}

.nav-link-active::after {
  transform: scaleX(1);
}

/* ========================================
   TYPOGRAPHY SYSTEM
   ======================================== */

.text-display {
  font-size: clamp(2.5rem, 5vw, 4rem);
  font-weight: 500;
  line-height: 1.1;
  letter-spacing: -0.02em;
}

.text-h1 {
  font-size: clamp(1.75rem, 3vw, 2.25rem);
  font-weight: 500;
  line-height: 1.2;
  letter-spacing: -0.01em;
}

.text-h2 {
  font-size: 1.25rem;
  font-weight: 500;
  line-height: 1.3;
  letter-spacing: -0.01em;
}

.text-h3 {
  font-size: 1rem;
  font-weight: 500;
  line-height: 1.4;
}

.text-body {
  font-size: 1rem;
  line-height: 1.6;
}

.text-body-sm {
  font-size: 0.875rem;
  line-height: 1.5;
}

.text-caption {
  font-size: 0.75rem;
  line-height: 1.4;
  letter-spacing: 0.02em;
}

.text-label {
  font-size: 0.6875rem;
  font-weight: 500;
  line-height: 1;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

/* ========================================
   ANIMATIONS
   ======================================== */

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideIn {
  from {
    opacity: 0;
    transform: translateX(-8px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes slideInRight {
  from {
    opacity: 0;
    transform: translateX(100%);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes scrollIndicator {
  0% {
    transform: translateY(-100%);
    opacity: 0;
  }
  30% {
    opacity: 1;
  }
  100% {
    transform: translateY(200%);
    opacity: 0;
  }
}

/* Intersection Observer Animations */
.animate-on-scroll {
  opacity: 0;
  transform: translateY(24px);
  transition: 
    opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
    transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}

.animate-on-scroll.is-visible {
  opacity: 1;
  transform: translateY(0);
}

/* Delayed scroll indicator animation */
.animate-on-scroll-delay {
  opacity: 0;
  animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  animation-delay: 0.5s;
}

.animate-fade-in {
  animation: fadeIn 0.4s ease-out forwards;
}

.animate-slide-in {
  animation: slideIn 0.4s ease-out forwards;
}

.animate-slide-in-right {
  animation: slideInRight 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.animate-scroll-indicator {
  animation: scrollIndicator 1.5s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}

/* Staggered delays */
.delay-75 { animation-delay: 75ms; }
.delay-150 { animation-delay: 150ms; }
.delay-225 { animation-delay: 225ms; }
.delay-300 { animation-delay: 300ms; }
.delay-375 { animation-delay: 375ms; }

/* ========================================
   COMPONENTS
   ======================================== */

/* Button - Primary Orange */
.btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 10px 20px;
  background: var(--ultra-orange);
  color: white;
  font-size: 0.75rem;
  font-weight: 500;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  border: none;
  cursor: pointer;
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}

.btn-primary:hover {
  background: var(--medium-orange);
  transform: translateY(-1px);
}

.btn-primary:active {
  transform: translateY(0) scale(0.98);
}

/* Button - Ghost */
.btn-ghost {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 8px 0;
  background: transparent;
  color: var(--muted);
  font-size: 0.8125rem;
  font-weight: 400;
  border: none;
  cursor: pointer;
  transition: color 0.15s ease;
}

.btn-ghost:hover {
  color: var(--foreground);
}

/* Card Base */
.card {
  background: var(--surface);
  border: 1px solid var(--border);
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

.card:hover {
  border-color: var(--border-hover);
  transform: translateY(-2px);
}

/* Card - Featured variant */
.card-featured {
  background: var(--ultra-orange);
  border: 1px solid var(--ultra-orange);
}

.card-featured:hover {
  border-color: var(--medium-orange);
  box-shadow: 0 20px 40px rgba(255, 82, 51, 0.15);
}

/* Newsletter Card - Clean styling (no glow) */
.newsletter-card {
  position: relative;
  border: 2px solid var(--foreground);
  background: var(--surface);
  padding: 2rem;
  transition: border-color 0.3s ease, transform 0.3s ease;
}

@media (min-width: 1024px) {
  .newsletter-card {
    padding: 3rem;
  }
}

.newsletter-card:hover {
  border-color: var(--ultra-orange);
  transform: translateY(-2px);
}

/* ========================================
   PARALLAX SYSTEM - Pure CSS 3D
   ======================================== 
   
   Based on Chrome DevRel + Keith Clark research:
   https://developer.chrome.com/blog/performant-parallaxing
   https://keithclark.co.uk/articles/pure-css-parallax-websites/
   
   Why CSS 3D parallax is superior:
   1. GPU-accelerated - compositor handles transforms
   2. Scroll-coupled - no JavaScript events, no "best-effort" delivery
   3. No smoothing/transition - movement is 1:1 with scroll (premium feel)
   4. Works with scroll-snap (perspective on the snap container)
   
   How it works:
   - perspective on the scroll container creates 3D viewport
   - translateZ on children makes them scroll at different rates
   - Negative Z = slower scroll (appears further back)
   - Scale correction: scale = 1 + (translateZ * -1) / perspective
*/

/* Hero section - preserves 3D context from snap-container */
.hero-parallax-container {
  /* Critical: preserve 3D for children to inherit perspective from snap-container */
  transform-style: preserve-3d;
}

/* Wrapper for parallax elements - preserves 3D context */
.parallax-wrapper {
  position: absolute;
  inset: 0;
  overflow: visible; /* Allow elements to extend beyond during parallax */
  pointer-events: none;
  user-select: none;
  
  /* CRITICAL: preserve the 3D context from parent */
  transform-style: preserve-3d;
}

/* Base parallax layer styling */
.parallax-layer {
  position: absolute;
  
  /* NO transition - this was causing the "disconnected" feel!
     Movement must be instant/scroll-coupled for premium parallax */
  
  /* GPU hint - browser can optimize knowing these will change */
  will-change: transform;
  
  /* Ensure proper 3D rendering */
  backface-visibility: hidden;
}

/*
 * Parallax depth layers
 * 
 * With perspective: 300px (on .snap-container), the scale formula is:
 * scale = 1 + (translateZ * -1) / 300
 * 
 * Layer speeds (how fast they scroll relative to content):
 * - deep: translateZ(-100px) → scale(1.333) → scrolls at ~0.75x (slowest)
 * - mid:  translateZ(-60px)  → scale(1.2)   → scrolls at ~0.83x
 * - near: translateZ(-30px)  → scale(1.1)   → scrolls at ~0.91x (fastest decorative)
 * 
 * These subtle differences create depth without being distracting.
 * The effect is most noticeable at section boundaries.
 */

/* Deep layer - slowest, appears furthest back */
.parallax-layer--deep {
  transform: translateZ(-100px) scale(1.333);
}

/* Mid layer - medium depth */
.parallax-layer--mid {
  transform: translateZ(-60px) scale(1.2);
}

/* Near layer - subtle parallax, closest decorative element */
.parallax-layer--near {
  transform: translateZ(-30px) scale(1.1);
}

/* 
 * Mobile: Disable parallax for performance and UX
 * Premium sites (Apple, Stripe) typically disable parallax on mobile
 * Reasons:
 * - Touch scrolling momentum doesn't work well with 3D transforms
 * - Smaller screens don't benefit as much from depth effects
 * - Battery/performance considerations
 */
@media (max-width: 768px) {
  .snap-container {
    perspective: none;
  }
  
  .snap-section,
  .hero-parallax-container,
  .parallax-wrapper {
    transform-style: flat;
  }
  
  .parallax-layer--deep,
  .parallax-layer--mid,
  .parallax-layer--near {
    transform: none;
  }
}

/* Badge */
.badge {
  display: inline-flex;
  align-items: center;
  padding: 6px 12px;
  font-size: 0.625rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  border: 1px solid;
}

.badge-orange {
  background: var(--ultra-orange);
  border-color: var(--ultra-orange);
  color: white;
  box-shadow: 0 2px 8px rgba(255, 82, 51, 0.3);
}

.badge-outline {
  background: transparent;
  border-color: var(--border);
  color: var(--muted);
}

.badge-ghost {
  background: transparent;
  border-color: transparent;
  color: var(--muted);
  padding: 0;
}

/* Tag */
.tag {
  display: inline-flex;
  padding: 3px 8px;
  background: var(--surface-hover);
  border: 1px solid var(--border);
  font-size: 0.6875rem;
  color: var(--muted);
  transition: all 0.15s ease;
}

.tag:hover {
  border-color: var(--border-hover);
  color: var(--foreground);
}

/* Divider */
.divider {
  height: 1px;
  background: var(--border);
}

.divider-vertical {
  width: 1px;
  height: 100%;
  background: var(--border);
}

/* Link arrow animation */
.link-arrow {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  color: var(--muted);
  font-size: 0.8125rem;
  transition: all 0.2s ease;
}

.link-arrow:hover {
  color: var(--ultra-orange);
}

.link-arrow svg {
  transition: transform 0.2s ease;
}

.link-arrow:hover svg {
  transform: translateX(3px);
}

/* ========================================
   FORM ELEMENTS
   ======================================== */

.input {
  width: 100%;
  padding: 14px 16px;
  background: var(--surface-hover);
  border: 1px solid var(--border);
  color: var(--foreground);
  font-size: 0.9375rem;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.input::placeholder {
  color: var(--muted);
}

.input:focus {
  outline: none;
  border-color: var(--ultra-orange);
  box-shadow: 0 0 0 3px rgba(255, 82, 51, 0.1);
}

/* ========================================
   LAYOUT HELPERS
   ======================================== */

.container {
  width: 100%;
  max-width: 1536px;
  margin: 0 auto;
  padding: 0 16px;
}

@media (min-width: 640px) {
  .container {
    padding: 0 20px;
  }
}

@media (min-width: 1024px) {
  .container {
    padding: 0 32px;
  }
}

@media (min-width: 1280px) {
  .container {
    padding: 0 40px;
  }
}

/* Grid layout */
.grid-editorial {
  display: grid;
  gap: 1px;
  background: var(--border);
}

.grid-editorial > * {
  background: var(--background);
}

/* ========================================
   SELECTION & SCROLLBAR
   ======================================== */

::selection {
  background: rgba(255, 82, 51, 0.3);
  color: var(--foreground);
}

::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

::-webkit-scrollbar-track {
  background: var(--background);
}

::-webkit-scrollbar-thumb {
  background: var(--border);
  border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
  background: var(--border-hover);
}

/* ========================================
   DECORATIVE ELEMENTS - RESPONSIVE SYSTEM
   ========================================
   
   Design System Philosophy:
   
   1. GRID is the ANCHOR - largest element, defines composition center
   2. Composition center sits at ~65-70% of viewport width (not pushed to edge)
   3. Ring OVERLAPS top-left of Grid (creates depth)
   4. Plus OVERLAPS bottom-right of Grid (creates depth)
   5. All three form a cohesive, tight grouping
   
   Size Ratios (maintained across breakpoints):
   - Grid: 1.0 (base)
   - Ring: ~0.55 of Grid
   - Plus: ~0.50 of Grid
   
   Positioning uses LEFT-based anchoring for the Grid (easier to reason about
   where the composition sits), with Ring/Plus positioned relative to viewport
   to create overlap.
*/

:root {
  /* 
   * GRID (anchor) - Center of composition
   * Left edge at ~48% puts center around 65-68% of viewport
   */
  --deco-grid-top: 15%;
  --deco-grid-left: 48%;
  --deco-grid-size: clamp(280px, 38vw, 650px);
  --deco-grid-opacity: 1;
  
  /* 
   * RING - Overlaps top-left of Grid
   * Positioned to overlap ~40% with Grid's top-left area
   */
  --deco-ring-top: 0%;
  --deco-ring-left: 42%;
  --deco-ring-size: clamp(150px, 20vw, 360px);
  --deco-ring-opacity: 1;
  
  /* 
   * PLUS - Overlaps bottom-right of Grid  
   * Positioned to create downward visual flow
   */
  --deco-plus-bottom: 2%;
  --deco-plus-left: 55%;
  --deco-plus-size: clamp(130px, 18vw, 320px);
  --deco-plus-opacity: 1;
}

/* Extra large desktop (2560px+) - scale up aggressively */
@media (min-width: 2560px) {
  :root {
    --deco-grid-top: 12%;
    --deco-grid-left: 50%;
    --deco-grid-size: 800px;
    
    --deco-ring-top: -2%;
    --deco-ring-left: 44%;
    --deco-ring-size: 440px;
    
    --deco-plus-bottom: 5%;
    --deco-plus-left: 58%;
    --deco-plus-size: 400px;
  }
}

/* Large desktop (1920px - 2559px) - prominent but balanced */
@media (min-width: 1920px) and (max-width: 2559px) {
  :root {
    --deco-grid-top: 12%;
    --deco-grid-left: 48%;
    --deco-grid-size: 620px;
    
    --deco-ring-top: -2%;
    --deco-ring-left: 42%;
    --deco-ring-size: 360px;
    
    --deco-plus-bottom: 5%;
    --deco-plus-left: 56%;
    --deco-plus-size: 320px;
  }
}

/* Standard desktop (1440px - 1919px) - tight, harmonious */
@media (min-width: 1440px) and (max-width: 1919px) {
  :root {
    --deco-grid-top: 14%;
    --deco-grid-left: 48%;
    --deco-grid-size: 500px;
    
    --deco-ring-top: 0%;
    --deco-ring-left: 42%;
    --deco-ring-size: 280px;
    
    --deco-plus-bottom: 6%;
    --deco-plus-left: 55%;
    --deco-plus-size: 260px;
  }
}

/* Small desktop (1280px - 1439px) - common laptop size */
@media (min-width: 1280px) and (max-width: 1439px) {
  :root {
    --deco-grid-top: 16%;
    --deco-grid-left: 50%;
    --deco-grid-size: 420px;
    
    --deco-ring-top: 2%;
    --deco-ring-left: 44%;
    --deco-ring-size: 240px;
    
    --deco-plus-bottom: 8%;
    --deco-plus-left: 56%;
    --deco-plus-size: 220px;
  }
}

/* Large tablet / small laptop (1024px - 1279px) */
@media (min-width: 1024px) and (max-width: 1279px) {
  :root {
    --deco-grid-top: 18%;
    --deco-grid-left: 52%;
    --deco-grid-size: 360px;
    
    --deco-ring-top: 4%;
    --deco-ring-left: 48%;
    --deco-ring-size: 200px;
    
    --deco-plus-bottom: 10%;
    --deco-plus-left: 58%;
    --deco-plus-size: 180px;
  }
}

/* Tablet portrait (768px - 1023px) 
   Content takes full width on tablet, so figures must be far right
   Treat as background accents, not focal elements */
@media (min-width: 768px) and (max-width: 1023px) {
  :root {
    --deco-grid-top: 15%;
    --deco-grid-left: 68%;
    --deco-grid-size: 320px;
    --deco-grid-opacity: 0.5;
    
    --deco-ring-top: 3%;
    --deco-ring-left: 72%;
    --deco-ring-size: 180px;
    --deco-ring-opacity: 0.7;
    
    --deco-plus-bottom: 10%;
    --deco-plus-left: 70%;
    --deco-plus-size: 160px;
    --deco-plus-opacity: 0.6;
  }
}

/* Mobile landscape (640px - 767px) 
   Figures as subtle background texture */
@media (min-width: 640px) and (max-width: 767px) {
  :root {
    --deco-grid-top: 18%;
    --deco-grid-left: 72%;
    --deco-grid-size: 260px;
    --deco-grid-opacity: 0.4;
    
    --deco-ring-top: 2%;
    --deco-ring-left: 75%;
    --deco-ring-size: 150px;
    --deco-ring-opacity: 0.65;
    
    --deco-plus-bottom: 8%;
    --deco-plus-left: 72%;
    --deco-plus-size: 130px;
    --deco-plus-opacity: 0.55;
  }
}

/* Mobile portrait (< 640px) 
   Bold, visible figures but pushed to right to avoid content
   Larger than previous implementation per feedback */
@media (max-width: 639px) {
  :root {
    /* Grid - subtle texture, partially off-screen right */
    --deco-grid-top: 20%;
    --deco-grid-left: 75%;
    --deco-grid-size: 220px;
    --deco-grid-opacity: 0.3;
    
    /* Ring - main decorative focus, prominent */
    --deco-ring-top: 0%;
    --deco-ring-left: 70%;
    --deco-ring-size: 140px;
    --deco-ring-opacity: 0.75;
    
    /* Plus - anchors bottom right */
    --deco-plus-bottom: 5%;
    --deco-plus-left: 68%;
    --deco-plus-size: 120px;
    --deco-plus-opacity: 0.7;
  }
}

/* Decorative element base styles using custom properties */
.deco-ring {
  position: absolute;
  top: var(--deco-ring-top);
  left: var(--deco-ring-left);
  width: var(--deco-ring-size);
  height: auto;
  opacity: var(--deco-ring-opacity);
  transition: opacity 0.3s ease;
}

.deco-grid {
  position: absolute;
  top: var(--deco-grid-top);
  left: var(--deco-grid-left);
  width: var(--deco-grid-size);
  height: auto;
  opacity: var(--deco-grid-opacity);
  transition: opacity 0.3s ease;
}

.deco-plus {
  position: absolute;
  bottom: var(--deco-plus-bottom);
  left: var(--deco-plus-left);
  width: var(--deco-plus-size);
  height: auto;
  opacity: var(--deco-plus-opacity);
  transition: opacity 0.3s ease;
}

/* ========================================
   CUSTOM UTILITIES
   ======================================== */

/* Hover reveal for children */
.hover-reveal .reveal-target {
  opacity: 0;
  transition: opacity 0.2s ease;
}

.hover-reveal:hover .reveal-target {
  opacity: 1;
}

/* Subtle glow effect on featured items */
.glow-orange {
  box-shadow: 0 0 60px rgba(255, 82, 51, 0.1);
}

/* Border subtle hover */
.border-hover {
  transition: border-color 0.2s ease;
}

.border-hover:hover {
  border-color: var(--border-hover) !important;
}

/* Theme toggle button */
.theme-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  background: transparent;
  border: 1px solid var(--border);
  border-radius: 6px;
  color: var(--muted);
  cursor: pointer;
  transition: all 0.2s ease;
}

.theme-toggle:hover {
  border-color: var(--border-hover);
  color: var(--foreground);
}
